# Copy to .env and fill in values before running

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme_replace_with_64_char_random_string

# App
DEBUG=false
ENVIRONMENT=production

# Database (matches docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://securescope:securescope@db:5432/securescope
DATABASE_SYNC_URL=postgresql://securescope:securescope@db:5432/securescope

# Redis
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS — comma-separated JSON array
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:80"]

# Scanner timeouts (seconds)
HTTP_TIMEOUT=15
SSL_TIMEOUT=10

# Email (optional — leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
